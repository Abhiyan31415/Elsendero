# Copy to .env (`cp .env.example .env`). Real environment variables win over this file.
PORT=5000

# Postgres connection string (required). SSL defaults on in production; set DATABASE_SSL=false to disable.
DATABASE_URL=postgres://gantabya:gantabya@localhost:5432/gantabya
# DATABASE_SSL=

# Long random string (required), e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Allowed frontend origins, comma separated (defaults to localhost:3000 and :5173)
CLIENT_URL=http://localhost:3000
# Public address of this API, used for uploaded image URLs
PUBLIC_API_URL=http://localhost:5000

# Cloudflare R2. Without both keys, uploads are stored on local disk (not allowed in production).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=

# Optional: Redis for the socket.io adapter and shared rate limits
# REDIS_URL=redis://localhost:6379

# Email (verification + password reset) via Resend. Required in production.
# Without a key in development, emails are printed to the server log instead.
RESEND_API_KEY=
# Sender; must be on a domain verified in Resend. The default test sender only delivers to your own Resend account email.
# EMAIL_FROM=Gantabya <no-reply@your-domain.com>
# Frontend address used in email links (defaults to the first CLIENT_URL origin)
# APP_URL=http://localhost:3000
