# Port the HTTP server listens on (Render/Railway set this automatically)
PORT=5000

# MongoDB connection string (e.g. MongoDB Atlas). REQUIRED.
MONGO_CONNECT=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/elsendero?retryWrites=true&w=majority

# Secret used to sign login tokens. REQUIRED. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long login tokens stay valid (jsonwebtoken format: 7d, 12h, 3600 ...). Default: 7d
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed by CORS and Socket.io (no trailing slash).
# Default: http://localhost:5173
CLIENT_URL=http://localhost:5173,https://elsendero.netlify.app
