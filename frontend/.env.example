# Copy to .env (`cp .env.example .env`) for local development.
# On Netlify, set these under Site configuration -> Environment variables.
# Vite only exposes variables prefixed with VITE_, and they are baked in at build time.

# Base URL of the backend API / Socket.IO server (no trailing slash).
VITE_API_URL=http://localhost:5000

# Public Mapbox access token (pk.*) — https://account.mapbox.com/access-tokens/
# Restrict it to your site's URLs in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=your_mapbox_token
