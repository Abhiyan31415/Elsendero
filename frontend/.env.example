# Copy to .env.local (`cp .env.example .env.local`) for local development.
# On Netlify, set these under Site configuration -> Environment variables.
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time.

# Backend origin serving /api/v1 and Socket.IO (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public Mapbox access token (pk.*) — https://account.mapbox.com/access-tokens/
# Restrict it to your site's URLs in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# Optional: public URL of this site, used for absolute OpenGraph/canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
